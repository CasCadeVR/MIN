<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="16">
        <StackPanel.Styles>
          <Style Selector="ComboBox">
            <Setter Property="Margin" Value="0,4" />
          </Style>
        </StackPanel.Styles>

        <TextBlock Classes="header5" Text="Закрытый" />
        <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0">
          <ComboBoxItem>Устройство 1</ComboBoxItem>
          <ComboBoxItem>Устройство 2</ComboBoxItem>
          <ComboBoxItem>Устройство 3</ComboBoxItem>
        </ComboBox>

        <TextBlock Classes="header5" Text="Без выбора (placeholder)" />
        <ComboBox HorizontalAlignment="Stretch">
          <ComboBoxItem>Устройство 1</ComboBoxItem>
          <ComboBoxItem>Устройство 2</ComboBoxItem>
        </ComboBox>

        <TextBlock Classes="header5" Text="Открытый" />
        <ComboBox HorizontalAlignment="Stretch" IsDropDownOpen="True">
          <ComboBoxItem>Устройство 1</ComboBoxItem>
          <ComboBoxItem>Устройство 2</ComboBoxItem>
          <ComboBoxItem>Устройство 3</ComboBoxItem>
          <ComboBoxItem>Очень длинное название устройства которое должно переноситься по строкам в выпадающем списке</ComboBoxItem>
        </ComboBox>

        <TextBlock Classes="header5" Text="Disabled" />
        <ComboBox HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0">
          <ComboBoxItem>Устройство 1</ComboBoxItem>
        </ComboBox>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!--  Base / closed state  -->
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceInput}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
    <Setter Property="Padding" Value="{DynamicResource PaddingInput}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource TextDisabled}" />
    <Setter Property="Cursor" Value="Hand" />

    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>

    <!--  Hover  -->
    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="^:pointerover /template/ Path">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!--  Dropdown open  -->
    <Style Selector="^:dropdownopen">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:dropdownopen /template/ Path">
      <Setter Property="Stroke" Value="{DynamicResource Primary}" />
    </Style>

    <!--  Disabled  -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceDisabled}" />
    </Style>

    <!--  Selected item  -->
    <Style Selector="^ /template/ ContentControl">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Placeholder  -->
    <Style Selector="^ /template/ TextBlock#PlaceholderTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>

    <!--  Toggle arrow (chevron): bigger + breathing room on the right  -->
    <Style Selector="^ /template/ ToggleButton#toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0,0,10,0" />

      <Setter Property="Template">
        <ControlTemplate>
          <Path
            Data="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"
            Height="6"
            HorizontalAlignment="Center"
            RenderTransformOrigin="50%,50%"
            Stretch="Uniform"
            Stroke="{DynamicResource TextSecondary}"
            StrokeThickness="1"
            VerticalAlignment="Center"
            Width="12">
            <Path.RenderTransform>
              <RotateTransform />
            </Path.RenderTransform>
          </Path>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^ /template/ ToggleButton#toggle:checked /template/ Path">
      <Style.Animations>
        <Animation Duration="0:0:0.1" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="180" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^ /template/ ToggleButton#toggle:unchecked /template/ Path">
      <Style.Animations>
        <Animation Duration="0:0:0.1" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="180" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

<Style Selector="^ /template/ Popup > Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Padding" Value="4,4,-12,4" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
    <Setter Property="MaxWidth"
              Value="{Binding Bounds.Width,
                              RelativeSource={RelativeSource TemplatedParent}}" />

      <Style.Animations>
        <Animation Duration="0:0:0.2" FillMode="Both">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Style>

  <!--  Items  -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusDefault}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />

    <Style Selector="^ TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="^:pointerover">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
    </Style>

    <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
    </Style>

    <Style Selector="^:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}" />
    </Style>
  </Style>
</Styles>
