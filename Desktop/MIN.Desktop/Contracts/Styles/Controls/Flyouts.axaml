<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="using:Avalonia.Svg.Skia">
    <Design.PreviewWith>
        <Border Padding="250">
           <Border Background="{DynamicResource SidebarSecondaryBackground}" Padding="20">
            <StackPanel>
                <Button Classes="card">
                     <Button.Flyout>
                        <Flyout Placement="Left" FlyoutPresenterClasses="cardDetails">
                            <Border>
                                <StackPanel Spacing="8">
                                     <DockPanel HorizontalSpacing="6">
                                        <TextBlock  DockPanel.Dock="Right"
                                            Text="Роль участника" />

                                        <SelectableTextBlock
                                            Classes="header5"
                                            Text="Имя участника" />
                                    </DockPanel>
                                    <TextBlock Text="В сети" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                        <StackPanel Spacing="6">
                            <DockPanel HorizontalSpacing="6">
                                <TextBlock  DockPanel.Dock="Right"
                                    Text="Роль участника" />

                                <SelectableTextBlock
                                    Classes="header5"
                                    Text="Имя участника" />
                            </DockPanel>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="В сети" />
                        </StackPanel>
                    </Button>
                  <Button Content="Button with flyout">
                    <Button.Flyout >
                      <Flyout FlyoutPresenterClasses="buttons">
                          <StackPanel>
                            <Button
                            Classes="no-background">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/file-upload.svg" />
                                <TextBlock VerticalAlignment="Center"
                                            Text="Отправить файл" />
                            </StackPanel>
                        </Button>
                                   
                        <Button
                            Classes="no-background">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/rocket.svg" />
                                <TextBlock VerticalAlignment="Center"
                                            Text="Начать активность" />
                            </StackPanel>
                        </Button>
                         </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

     <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />

        <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        <Setter Property="Opacity" Value="0" />

          <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                    <!-- Здесь Padding принудительно установлен в PaddingSmall,
                    а то что-то по умочанию справа есть неубераемый padding -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{DynamicResource PaddingSmall}"/>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Animations>
            <Animation Duration="0:0:0.2" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

     <Style Selector="FlyoutPresenter.buttons">
        <Style Selector="^ Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{DynamicResource PaddingSmall}" />

            <Style Selector="^ > StackPanel">
                <Setter Property="Spacing" Value="4" />
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>
        </Style>
    </Style>

    <Style Selector="FlyoutPresenter.cardDetails /template/ ContentPresenter">
        <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
    </Style>

    <Style Selector="FlyoutPresenter.cardDetails Border">
        <Setter Property="MinWidth" Value="200" />
    </Style>

</Styles>
