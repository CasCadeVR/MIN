<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
        <StackPanel>
            <StackPanel.Styles>
                <Style Selector="RadioButton">
                    <Setter Property="Margin" Value="5"></Setter>
                </Style>
            </StackPanel.Styles>

            <RadioButton Classes="secondary">Поставить галочку</RadioButton>
        </StackPanel>
    </Border>
  </Design.PreviewWith>

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="RadioButton:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHover}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource Primary}"/>
    </Style>
</Styles>
