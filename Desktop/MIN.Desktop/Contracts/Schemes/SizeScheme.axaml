<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 
    <!-- *************** -->
    <!-- SIZES           -->
    <!-- *************** -->

    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusDefault">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>

    <Thickness x:Key="PaddingButton">16,8</Thickness>
    <Thickness x:Key="PaddingCard">12</Thickness>
    <Thickness x:Key="PaddingPage">24</Thickness>

     <Design.PreviewWith>
        <Border Padding="{DynamicResource PaddingPage}">
            <StackPanel Spacing="16" Width="300">
                <TextBlock Text="Preview" FontSize="{DynamicResource FontSizeH1}"
                           Foreground="{DynamicResource TextPrimary}"/>

                <Button Classes="primary" Content="Primary Button"/>
                <Button Classes="secondary" Content="Secondary Button"/>

                <Border Background="{DynamicResource Surface}" CornerRadius="8"
                        BorderBrush="{DynamicResource Primary}" BorderThickness="1"
                        Padding="{DynamicResource PaddingCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Card Title" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Description text" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <TextBox BorderBrush="{DynamicResource Primary}"
                         BorderThickness="1"
                         WatermarkForeground="{DynamicResource TextPrimary}"
                         PlaceholderText="Input field" Watermark="Type here..."/>
                <CheckBox Content="Checkbox option"/>
                <ProgressBar Value="60" Height="8" CornerRadius="4"
                             Foreground="{DynamicResource Primary}"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

</ResourceDictionary>
