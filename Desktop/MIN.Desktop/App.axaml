<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MIN.Desktop.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Contracts/Schemes/FontScheme.axaml"/>
                <ResourceInclude Source="/Contracts/Schemes/ColorScheme.axaml"/>
                <ResourceInclude Source="/Contracts/Schemes/SizeScheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="/Contracts/Styles/Buttons.axaml"/>
        <StyleInclude Source="/Contracts/Styles/CheckBoxes.axaml"/>
        <StyleInclude Source="/Contracts/Styles/RadioBoxes.axaml"/>
        <StyleInclude Source="/Contracts/Styles/TextBoxes.axaml"/>
    </Application.Styles>
</Application>
