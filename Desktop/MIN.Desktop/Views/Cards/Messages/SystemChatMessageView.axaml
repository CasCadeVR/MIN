<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:MIN.Desktop.ViewModels.Cards.Messages"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="20"
             x:DataType="vm:SystemChatMessageViewModel"
             x:Class="MIN.Desktop.Views.Cards.Messages.SystemChatMessageView">

    <Design.DataContext>
        <vm:SystemChatMessageViewModel/>
    </Design.DataContext>

    <Border Classes="message-row"
        Classes.private="{Binding IsPrivate}"
        Classes.selected="{Binding IsSelected}">
        <Interaction.Behaviors>
            <EventTriggerBehavior EventName="PointerPressed">
                <InvokeCommandAction
                    Command="{Binding ClickCommand}" />
            </EventTriggerBehavior>
        </Interaction.Behaviors>

        <Border Classes="message system"
            HorizontalAlignment="Center">
            <TextBlock
                Classes="chat"
                Foreground="{DynamicResource TextOnPrimary}"
                HorizontalAlignment="Center"
                Text="{Binding Text}" />
        </Border>
    </Border>
</UserControl>
