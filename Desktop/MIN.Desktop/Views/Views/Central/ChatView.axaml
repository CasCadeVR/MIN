<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:MIN.Desktop.ViewModels.Pages.ChatViewModels"
             xmlns:behaviors="using:MIN.Desktop.Contracts.Behaviors"
             xmlns:messages="using:MIN.Desktop.ViewModels.Cards.Messages"
             xmlns:designer="using:MIN.Desktop.Contracts.Designer"
             xmlns:converters="using:MIN.Desktop.Infrastructure.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
             x:DataType="vm:ChatViewModel"
             Padding="{DynamicResource PaddingPage}"
             x:Class="MIN.Desktop.Views.Central.ChatView">

    <Design.DataContext>
        <designer:DesignerChatViewModel/>
    </Design.DataContext>

    <Border>
        <DockPanel VerticalSpacing="10" >
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SidebarBackground}"
                    Padding="{DynamicResource PaddingTopBar}"
                    CornerRadius="{DynamicResource CornerRadiusLarge}">
                <DockPanel
                    HorizontalSpacing="8">

                    <Button
                        Command="{Binding DisconnectCommand}"
                        Content="Выйти" />

                     <Button
                        Command="{Binding ToggleSideBarCommand}"
                        Classes="icon"
                        DockPanel.Dock="Right">
                            <Svg Path="/Assets/Icons/about.svg" />
                     </Button>

                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        Classes="header5"
                        Text="Комната " />

                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="header3"
                        Text="{Binding RoomName}" />
                </DockPanel>
            </Border>

             <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SidebarBackground}"
                    Padding="{DynamicResource PaddingTopBar}"
                    CornerRadius="{DynamicResource CornerRadiusLarge}">
    
                    <DockPanel HorizontalSpacing="8" >
                        <Button
                            VerticalAlignment="Bottom"
                            DockPanel.Dock="Left"
                            Classes="icon">
                            <Svg Path="/Assets/Icons/plus.svg" />
                        </Button>

                        <Button
                            Command="{Binding SendMessageCommand}"
                            VerticalAlignment="Bottom"
                            Classes="icon primary"
                            DockPanel.Dock="Right"
                            HotKey="Enter">
                                <Svg Path="/Assets/Icons/send.svg" />
                        </Button>

                        <TextBox
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MaxLines="10"
                            Text="{Binding SendingMessage}"
                            PlaceholderText="Сообщение" />
                    </DockPanel>
             </Border>

            <!-- Messages -->

            <ScrollViewer behaviors:AutoScrollToBottomBehavior.AutoScroll="True"
                  VerticalScrollBarVisibility="Auto" DockPanel.Dock="Bottom" Classes="main">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <designer:MultiDataTemplate UseCache="False">
                            <!-- Системное сообщение -->

                            <DataTemplate x:DataType="messages:SystemChatMessageViewModel">
                               <Border Classes="message-row"
                                    Classes.private="{Binding IsPrivate}"
                                    Classes.selected="{Binding IsSelected}">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Text="{Binding Text}" />
                                </Border>
                            </DataTemplate>

                            <!-- Текстовое сообщение -->

                            <DataTemplate x:DataType="messages:ChatTextMessageViewModel">
                                <Border Classes="message-row"
                                    Classes.private="{Binding IsPrivate}"
                                    Classes.selected="{Binding IsSelected}">

                                    <Border Classes="message"
                                        Padding="{DynamicResource PaddingMedium}"
                                        Classes.self="{Binding IsLocal}"
                                        HorizontalAlignment="{Binding IsLocal, Converter={converters:BoolToMessageAlignConverter}}">
                                        <StackPanel Spacing="8">
                                            <DockPanel HorizontalSpacing="8" IsVisible="{Binding !RemoveHeaders}">
                                                <TextBlock Classes="small"
                                                    FontWeight="Bold"
                                                    Text="{Binding SenderName}" />

                                                <TextBlock Classes="small"
                                                    IsVisible="{Binding IsHost}"
                                                    Text="Хост"
                                                    DockPanel.Dock="Right" />
                                            </DockPanel>

                                            <DockPanel HorizontalSpacing="8">
                                                <SelectableTextBlock
                                                    Text="{Binding ChatMessage.Content}" />

                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    Classes="caption"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Text="{Binding Timestamp}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </designer:MultiDataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
