<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MIN.Desktop.ViewModels.Windows"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:designer="using:MIN.Desktop.Contracts.Designer"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="500"
        Width="1024" Height="500"
        MinWidth="800" MinHeight="500"
        x:Class="MIN.Desktop.Views.Modals.DialogBoxView"
        x:DataType="vm:MainWindowViewModel"
        Title="MIN">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <designer:DesignerMainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="18,*" >
        <Border Grid.Row="1" >
            <DockPanel>
                    
            </DockPanel>
        </Border>
    </Grid>
</Window>
