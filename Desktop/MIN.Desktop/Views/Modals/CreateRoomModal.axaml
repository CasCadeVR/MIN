<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MIN.Desktop.ViewModels.Modals"
        xmlns:controls="using:MIN.Desktop.TemplatedControls"
        xmlns:behaviors="using:MIN.Desktop.Contracts.Behaviors"
        xmlns:converters="using:MIN.Desktop.Infrastructure.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="450"
        d:DesignWidth="800"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        x:Class="MIN.Desktop.Views.Modals.CreateRoomModal"
        x:DataType="vm:CreateRoomViewModel"
        Title="MIN - Новая комната">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:CreateRoomViewModel/>
    </Design.DataContext>

    <DockPanel>
        <controls:CustomTitleBar CanMinimize="False" CanMaximize="False" />

        <StackPanel>
            <StackPanel Classes="form" Margin="24">
                <TextBlock Classes="modalHeader" Text="Create a server" />
                <StackPanel Classes="form">
                    <TextBlock Text="SERVER NAME" />
                    <TextBox
                        MaxLength="120"
                        MaxWidth="400"
                        Text="{Binding Name, Converter={converters:TrimConverter}}"
                        Watermark="Имя комнаты">
                        <Interaction.Behaviors>
                            <behaviors:FocusOnViewShowBehavior />
                        </Interaction.Behaviors>
                    </TextBox>
                </StackPanel>
                <StackPanel Classes="form">
                    <TextBlock Text="GAMEMODE" />
                    
                </StackPanel>
            </StackPanel>
            <Border Classes="footer">
                <Panel>
                    <Button
                        Command="{Binding CloseCommand}"
                        Content="Back"
                        FontWeight="Bold"
                        HotKey="Escape" />
                    <Button
                        Classes="primary"
                        Command="{Binding CreateCommand}"
                        Content="Create"
                        HorizontalAlignment="Right"
                        HotKey="Enter" />
                </Panel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
