<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MIN.Desktop.ViewModels.Windows"
        xmlns:pagesVm="using:MIN.Desktop.ViewModels.Pages"
        xmlns:pagesCentral="using:MIN.Desktop.Views.Central"
        xmlns:pagesLeft="using:MIN.Desktop.Views.Left"
        xmlns:pagesRight="using:MIN.Desktop.Views.Right"
        xmlns:controls="using:MIN.Desktop.TemplatedControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:designer="using:MIN.Desktop.Contracts.Designer"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="500"
        Width="1024" Height="500"
        MinWidth="800" MinHeight="500"
        x:Class="MIN.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MIN">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <designer:DesignerMainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <controls:CustomTitleBar />

        <Grid>
            <Border Grid.Row="1" >
                <DockPanel>
                    <!--  Navigated content (left side)  -->
                    <ContentControl
                        Classes="content"
                        Content="{Binding LeftSideBarViewModel, TargetNullValue='No view set. You should not see this message.'}"
                        DockPanel.Dock="Left">
                        <ContentControl.ContentTemplate>
                            <designer:MultiDataTemplate UseCache="False">
                                <!--  Null view (which will be a string, see TargetNullValue)  -->
                                <DataTemplate x:DataType="system:String">
                                    <TextBox
                                        Focusable="False"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IsReadOnly="True"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                                <!-- Loading view -->
                                <DataTemplate x:DataType="system:Uri">
                                    <Svg Path="{Binding AbsolutePath}" Classes="theme" Height="50"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Svg.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform />
                                            </TransformGroup>
                                        </Svg.RenderTransform>
                                        <Svg.Styles>
                                            <Style Selector="Svg">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:.5" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Svg.Styles>
                                    </Svg>
                                </DataTemplate>
                                <DataTemplate x:DataType="designer:DesignerMainSideBarViewModel">
                                    <pagesLeft:MainSideBarView />
                                </DataTemplate>
                                <DataTemplate x:DataType="pagesVm:SettingsSideBarViewModel">
                                    <pagesLeft:SettingsSideBarView />
                                </DataTemplate>
                                <!--  Fallback view. This DataTemplate must be kept at the bottom.  -->
                                <DataTemplate x:DataType="system:Object">
                                    <TextBlock>
                                        <Run Text="No view for" />
                                        <Run Text="{Binding}" />
                                    </TextBlock>
                                </DataTemplate>
                            </designer:MultiDataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!--  Right content (right side bar)  -->
                    <ContentControl
                        Classes="content"
                        Content="{Binding RightSideBarViewModel}"
                        DockPanel.Dock="Right">
                        <ContentControl.ContentTemplate>
                            <designer:MultiDataTemplate UseCache="False">
                                <!--  Null view (which will be a string, see TargetNullValue)  -->
                                <DataTemplate x:DataType="system:String">
                                    <TextBox
                                        Focusable="False"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IsReadOnly="True"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                                <!-- Loading view -->
                                <DataTemplate x:DataType="system:Uri">
                                    <Svg Path="{Binding AbsolutePath}" Classes="theme" Height="50"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Svg.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform />
                                            </TransformGroup>
                                        </Svg.RenderTransform>
                                        <Svg.Styles>
                                            <Style Selector="Svg">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:.5" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Svg.Styles>
                                    </Svg>
                                </DataTemplate>
                                 <DataTemplate x:DataType="pagesVm:ChatSideBarViewModel">
                                    <pagesRight:ChatSideBarView />
                                </DataTemplate>
                                <!--  Fallback view. This DataTemplate must be kept at the bottom.  -->
                                <DataTemplate x:DataType="system:Object">
                                    <TextBlock>
                                        <Run Text="No view for" />
                                        <Run Text="{Binding}" />
                                    </TextBlock>
                                </DataTemplate>
                            </designer:MultiDataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!--  Center content  -->
                    <ContentControl
                        Classes="content"
                        Content="{Binding CentralViewModel, TargetNullValue='No view set. You should not see this message.'}">
                        <ContentControl.ContentTemplate>
                            <designer:MultiDataTemplate UseCache="False">
                                <!--  Null view (which will be a string, see TargetNullValue)  -->
                                <DataTemplate x:DataType="system:String">
                                    <TextBox
                                        Focusable="False"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        IsHitTestVisible="False"
                                        IsReadOnly="True"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </DataTemplate>
                                <!-- Loading view -->
                                <DataTemplate x:DataType="system:Uri">
                                    <Svg Path="{Binding AbsolutePath}" Classes="theme" Height="50"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Svg.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform />
                                            </TransformGroup>
                                        </Svg.RenderTransform>
                                        <Svg.Styles>
                                            <Style Selector="Svg">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:.5" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Svg.Styles>
                                    </Svg>
                                </DataTemplate>
                                <DataTemplate x:DataType="pagesVm:DiscoveryViewModel">
                                    <pagesCentral:DiscoveryView />
                                </DataTemplate>
                                <DataTemplate x:DataType="pagesVm:ChatViewModel">
                                    <pagesCentral:ChatView />
                                </DataTemplate>
                                <!--  Fallback view. This DataTemplate must be kept at the bottom.  -->
                                <DataTemplate x:DataType="system:Object">
                                    <TextBlock>
                                        <Run Text="No view for" />
                                        <Run Text="{Binding}" />
                                    </TextBlock>
                                </DataTemplate>
                            </designer:MultiDataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
